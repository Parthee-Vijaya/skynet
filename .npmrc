# Skynet workspace npm config
#
# legacy-peer-deps: suppress zod v3/v4 peer-conflict between the daemon
# (requires zod ^3) and @anthropic-ai/claude-agent-sdk (peer: zod ^4).
# Both versions coexist at runtime — the SDK uses only basic z.object/z.string
# patterns that work identically in v3. Remove when daemon upgrades to zod v4.
legacy-peer-deps=true
